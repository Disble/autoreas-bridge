{
  "version": 1,
  "enforcedPrefixes": ["frontend/src/features/activity/"],
  "features": [
    {
      "id": "debug-capture",
      "path": "frontend/src/features/activity/",
      "defaultTier": "important",
      "reason": "The Activity screen: what the user sees and touches",
      "overrides": [
        {"path": "frontend/src/features/activity/activity-source/activity-source.helpers.ts", "tier": "core", "reason": "Maps and validates every Go Activity payload the screen trusts"},
        {"path": "frontend/src/features/activity/ui/ActivityNow/activity-now.helpers.ts", "tier": "core", "reason": "Decides the status dot, the figures, the bars and their gaps, and the change wording"},
        {"path": "frontend/src/features/activity/activity-source/activity.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/activity-source/activity-source.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/activity-source/activity-source.constants.ts", "tier": "infrastructure", "reason": "Constants"},
        {"path": "frontend/src/features/activity/ui/ActivityNow/activity-now.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/ui/ActivityNow/activity-now.constants.ts", "tier": "infrastructure", "reason": "Constants"},
        {"path": "frontend/src/features/activity/ui/ActivityScreen/activity-screen.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/ui/ActivityScreen/activity-screen.constants.ts", "tier": "infrastructure", "reason": "Constants"},
        {"path": "frontend/src/features/activity/activity-source/activity-incident.helpers.ts", "tier": "core", "reason": "Maps the incident, request, run and run-story payloads and the found flags the detail panes trust"},
        {"path": "frontend/src/features/activity/ui/ActivityIncidents/activity-incidents.helpers.ts", "tier": "core", "reason": "Narrows the where filter and orders and words the incident and run list"},
        {"path": "frontend/src/features/activity/ui/ActivityIncidents/activity-incident-detail.helpers.ts", "tier": "core", "reason": "Places the window markers, marks failures and the trigger, words the folded request rows and picks the run an internal incident opens"},
        {"path": "frontend/src/features/activity/ui/ActivityIncidents/activity-request-detail.helpers.ts", "tier": "core", "reason": "Cuts the body preview that keeps a 64 KB body off the render path"},
        {"path": "frontend/src/features/activity/ui/ActivityRunStory/activity-run-story.helpers.ts", "tier": "core", "reason": "Decides the run outcome, step emphasis and opening step, and lays out recorded metadata"},
        {"path": "frontend/src/features/activity/ui/ActivityRunStory/activity-time.helpers.ts", "tier": "core", "reason": "Formats the local clock, durations and window offsets every Activity detail shows"},
        {"path": "frontend/src/features/activity/activity-source/activity-incident.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/ui/ActivityIncidents/activity-incidents.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/ui/ActivityIncidents/activity-incidents.constants.ts", "tier": "infrastructure", "reason": "Constants"},
        {"path": "frontend/src/features/activity/ui/ActivityRunStory/activity-run-story.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/ui/ActivityRunStory/activity-run-story.constants.ts", "tier": "infrastructure", "reason": "Constants"},
        {"path": "frontend/src/features/activity/history/activity-history.helpers.ts", "tier": "core", "reason": "Builds the 90-day calendar, merges day pages and places the no-data gaps"},
        {"path": "frontend/src/features/activity/recorder/activity-recorder.helpers.ts", "tier": "core", "reason": "Upserts live recorder rows, keeps a terminal state over a late pending emit and caps the list at 500"},
        {"path": "frontend/src/features/activity/history-source/history-source.helpers.ts", "tier": "core", "reason": "Maps and validates the History and recorder payloads"},
        {"path": "frontend/src/features/activity/history-source/history.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/history-source/history-source.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/history-source/history-source.constants.ts", "tier": "infrastructure", "reason": "Constants"},
        {"path": "frontend/src/features/activity/history/activity-history.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/history/activity-history.constants.ts", "tier": "infrastructure", "reason": "Constants"},
        {"path": "frontend/src/features/activity/recorder/activity-recorder.types.ts", "tier": "infrastructure", "reason": "Type declarations"},
        {"path": "frontend/src/features/activity/recorder/activity-recorder.constants.ts", "tier": "infrastructure", "reason": "Constants"}
      ]
    }
  ]
}
