build/bin
node_modules
frontend/dist/*
# ...except one placeholder, so the index builds on its own. main.go embeds this
# directory, and `go:embed` fails on a directory with no files -- which made a
# clean checkout not compile, and made mutation testing of the root package
# report a perfect score for mutants that never built.
!frontend/dist/index.html
resources/autoreas-data/*.dat
.atl/active-sdd-change
frontend/package.json.md5
# Wails regenerates these on every build (and wipes the runtime directory
# outright), so they were never editable source. frontend's postinstall hook
# rebuilds them into a fresh clone; run `bun --cwd=frontend run generate:bindings`
# after changing a bound Go method.
frontend/wailsjs/
frontend/.stryker-*/
frontend/reports/
resources/autoreas-bridge-full-icon.png
cmd/poc/.env
*.exe
.atl/skill-registry.md
.atl/.skill-registry.cache.json
.tools/

# Local-only backups / scratch (never commit)
.ignore/
opencode.json
.mcp.json

# Local AI runtime state
.atl/
