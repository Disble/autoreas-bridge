{
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 4,
  "ignoreStatic": true,
  "cleanTempDir": "always",
  "tempDirName": ".dlinter-mutation-tmp",
  "reporters": [
    "clear-text"
  ],
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  },
  "vitest": {
    "configFile": "vitest.dlinter-mutation.mts"
  }
}
