{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Architecture boundaries live in the file dharness owns; they arrive here by
  // reference so `dharness sync` can rewrite them without touching this file.
  "extends": ["../.dharness/fallow.jsonc"],
  "entry": [
    "src/main.{ts,tsx,js,jsx}",
    "src/test/setup.ts",
    // Vitest discovers this ESM script test, but Fallow does not infer it as
    // a test root because it lives outside `src`.
    "scripts/__tests__/check-file-size-warnings.test.mjs",
    // Same blind spot: an ESM script test outside `src`. It is the only
    // importer of `generate-wails-bindings.mjs`, which is otherwise reached
    // solely through package.json's postinstall hook.
    "scripts/__tests__/generate-wails-bindings.test.mjs",
    // Named as a string in `stryker.dlinter.json` -> `vitest.configFile`, the
    // same JSON-reference blind spot as the `ignoreDependencies` entries
    // below. It is a real entry point, not dead code: deleting it breaks the
    // staged mutation gate, so it is declared rather than ignored.
    "vitest.dlinter-mutation.mts",
    // The layout-smoke fixture page: a real entry point, built by
    // `vite.layout.config.ts` rather than by the app's own build, so the app's
    // import graph cannot reach it. Deleting it breaks the layout gate.
    "scripts/layout-fixtures/main.tsx",
    // Named as a string in package.json's `layout:smoke` script, the same
    // JSON-reference blind spot as the entries above.
    "vite.layout.config.ts",
    // Another ESM script test outside `src`, and the only importer of
    // `layout-smoke.mjs`'s verdict parser.
    "scripts/__tests__/layout-smoke.test.mjs",
    // Same blind spot once more: an ESM script test outside `src`, and the only
    // importer of the request-path resolver both smoke servers share.
    "scripts/__tests__/static-serve.helpers.test.mjs"
  ],
  "ignoreDependencies": [
    // `eslint` is imported only by `scripts/check-file-size-warnings.mjs`, a
    // repo-owned quality script reached from package.json scripts rather than
    // shipped frontend runtime code.
    "eslint",
    // `dharness-eslint-plugin` is named as a string inside `doctor.config.json`
    // and loaded by the `doctor:react` script, never imported from JS, so the
    // import graph cannot see it.
    "dharness-eslint-plugin",
    // `@stryker-mutator/vitest-runner` is named as a string in the `plugins`
    // list of `stryker.dlinter.json` and loaded by Stryker at runtime. Same
    // blind spot: a plugin referenced from JSON is invisible to the import
    // graph, and removing it would silently break the mutation gate.
    "@stryker-mutator/vitest-runner",
    // `@typescript-eslint/parser` is imported only by `eslint.config.js`, which
    // fallow classifies as production because it is not a test file. It is
    // tooling, exactly like `eslint` above, and moving it to `dependencies` to
    // silence the finding would ship a linter parser to users.
    "@typescript-eslint/parser"
  ],
  "audit": {
    "dupesBaseline": ".fallow/baselines/dupes.json"
  },
  // `dharness sync` reports this key as a two-owner collision with the presets
  // region of ../.dharness/fallow.jsonc, and the collision is DELIBERATE. The
  // dharness copy adds `"threshold": 3`, an absolute 3% ceiling on duplication.
  // This repository sits at 17.1% (3,960 lines across 117 files, measured
  // 2026-08-13) and has never gated on an absolute number: the policy is
  // no-regression against `audit.dupesBaseline`. Adopting the ceiling failed
  // the gate outright on an unchanged tree. Fallow resolves the project file
  // last, so the values below are the ones that run.
  //
  // `ignorePatterns` is NOT redeclared here — the dharness copy of that one is
  // identical and arrives through `extends`.
  "duplicates": {
    "mode": "semantic",
    // Hide pair-only clones; focus on widespread copy-paste worth refactoring.
    // Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    // 0 means "no limit" per fallow's schema, and it must be stated
    // explicitly: `extends` MERGES this object, so simply omitting `threshold`
    // leaves the dharness value of 3 in force rather than unsetting it.
    "threshold": 0
  }
}
