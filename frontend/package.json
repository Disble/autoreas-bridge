{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "filesize:warning": "node ./scripts/check-file-size-warnings.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "bun run lint && bun run typecheck",
    "doctor:react": "bunx react-doctor@0.5.7 --verbose --no-telemetry",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:mutation:guard": "node --test scripts/__tests__/mutation-staged.node-test.mjs",
    "test:mutation:staged": "node ./scripts/dlinter-mutation-staged.mjs",
    "generate:feature": "node ./scripts/generate-feature.js",
    "audit": "fallow audit --quiet",
    "check:no-barrels": "node ./scripts/check-no-barrels.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@iconify-icons/solar": "^1.2.3",
    "@iconify-icons/tabler": "^1.2.95",
    "@iconify/react": "^6.0.2",
    "@nivo/bar": "^0.99.0",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.14.0",
    "tailwindcss": "4.2.2",
    "zod": "4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "dlinter-ts-react": "^0.9.0",
    "eslint": "^9",
    "fallow": "^3.3.0",
    "jsdom": "29.0.2",
    "typescript": "6.0.2",
    "vite": "8.0.7",
    "vitest": "4.1.6"
  }
}
