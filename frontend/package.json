{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "filesize:warning": "node ./scripts/check-file-size-warnings.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "bun run lint && bun run typecheck",
    "doctor:react": "bunx react-doctor@0.5.7 --verbose --no-telemetry",
    "test": "vitest run",
    "test:mutation": "stryker run --concurrency 4",
    "check:staged": "node ./scripts/check-staged-quality.mjs",
    "test:mutation:staged": "dharness mutate --staged --exclude-prefix src/test/ --exclude-prefix scripts/ --exclude-prefix eslint.config.js --exclude-prefix vite.config.ts --exclude-prefix vite.layout.config.ts --exclude-prefix vitest.mutation.mts --exclude-prefix stryker.audit.config.mjs --concurrency 4",
    "test:mutation:audit": "stryker run stryker.audit.config.mjs --concurrency 2",
    "generate:feature": "node ./scripts/generate-feature.js",
    "render:smoke": "node ./scripts/render-smoke.mjs",
    "audit": "fallow audit --quiet",
    "postinstall": "node ./scripts/generate-wails-bindings.mjs",
    "generate:bindings": "node ./scripts/generate-wails-bindings.mjs",
    "layout:smoke": "node ./scripts/layout-smoke.mjs",
    "check:airis-assets": "node ./scripts/check-airis-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@iconify-icons/solar": "^1.2.4",
    "@iconify-icons/tabler": "^1.2.96",
    "@iconify/react": "^6.0.3",
    "@internationalized/date": "^3.12.4",
    "@nivo/bar": "^0.99.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.14.0",
    "tailwindcss": "4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.6",
    "dharness-eslint-plugin": "^0.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-doctor": "^0.9.18",
    "fallow": "^3.36.0",
    "jsdom": "29.0.2",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.6"
  }
}
