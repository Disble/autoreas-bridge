{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "filesize:warning": "node ./scripts/check-file-size-warnings.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "bun run lint && bun run typecheck",
    "doctor:react": "bunx react-doctor@0.5.7 --verbose --no-telemetry",
    "test": "vitest run",
    "generate:feature": "node ./scripts/generate-feature.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@iconify-icons/solar": "^1.2.3",
    "@iconify/react": "^6.0.2",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.14.0",
    "zod": "4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-doctor": "^0.5.7",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jsdom": "29.0.2",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.7",
    "vitest": "4.1.3"
  }
}
